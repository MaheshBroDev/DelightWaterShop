# --- PostgreSQL Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-super-secret-postgres-password-change-me

# --- JWT Secret & API Keys ---
# IMPORTANT: Generate secure random strings (min 32 characters) for production!
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlZmlnaHR3YXRlcnNob3AiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoyMDU2MDAwMDAwfQ.placeholder_anon_signature_generate_with_jwt_tool
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlZmlnaHR3YXRlcnNob3AiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIwNTYwMDAwMDB9.placeholder_service_role_signature_generate_with_jwt_tool

# --- API & Gateway (Kong) ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# --- Supabase Studio (Dashboard) ---
STUDIO_PORT=3000
SUPABASE_PUBLIC_URL=http://localhost:8000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=secure-dashboard-password

# --- Site & Frontend URL ---
SITE_URL=http://localhost:3001

# --- GoTrue (Authentication) ---
ENABLE_SIGNUP=true
JWT_EXPIRY=3600
MAILER_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@delightwatershop.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Delight Water Shop

# --- Storage ---
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800
STORAGE_S3_BUCKET=delight-water-storage
TENANT_ID=stub

# --- Analytics (Optional) ---
LOGFLARE_API_KEY=
