# Delight Water Shop - Frontend Environment Example
NODE_ENV=production
PORT=3001
# For browser access via public IP, set to http://YOUR_SERVER_IP:8100 or your domain
# For local dev, keep http://localhost:8100
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8100
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Host ports (can also be overridden at deploy time via env vars)
APP_PORT=3100
KONG_HTTP_PORT=8100
KONG_HTTPS_PORT=8543
